# Copia este archivo a .env (nunca lo subas a GitHub) y llena los valores.

# --- Base de datos MySQL de Hostinger (hPanel > Bases de datos) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Seguridad: OBLIGATORIO, mínimo 32 caracteres ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Sitio ---
PORT=3001
APP_URL=https://hostabroad.ca
# Solo si el frontend vive en otro dominio que el API:
# CORS_ORIGIN=https://hostabroad.ca,https://www.hostabroad.ca

# --- Pagos con Stripe (cuota de registro) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REGISTRATION_FEE_CAD=95

# Solo desarrollo local, para probar sin Stripe (se ignora en producción):
# ALLOW_FAKE_PAYMENTS=true
